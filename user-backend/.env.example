# User Backend (Go/Fiber) — copy to .env. NEVER commit the real .env.
PORT=8080

# Local dev: set these directly.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/cartoonflix
CLOUDFRONT_KEYPAIR_ID=
# Full PEM of the CloudFront PRIVATE key (never a .pem file in the repo).
CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Cloud (Lambda): set these ARNs instead; MONGO_URI / CLOUDFRONT_PRIVATE_KEY are
# fetched from Secrets Manager at runtime.
# MONGO_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/mongo-uri
# CF_KEY_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/cloudfront-private-key
# CLOUDFRONT_DOMAIN=<distribution-id>.cloudfront.net
