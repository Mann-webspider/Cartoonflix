# User Backend (Go/Fiber) — copy to .env and fill in. NEVER commit the real .env.
PORT=8080

# MongoDB Atlas serverless connection string
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/cartoonflix

# CloudFront signed-URL config
# KEYPAIR_ID is the CloudFront key group / public key id.
CLOUDFRONT_KEYPAIR_ID=

# Full PEM contents of the CloudFront PRIVATE key, injected at runtime from
# AWS Secrets Manager / SSM. Do NOT store a .pem file in the repo.
# Example (single line with literal \n, or use a multiline secret):
# CLOUDFRONT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
CLOUDFRONT_PRIVATE_KEY=
