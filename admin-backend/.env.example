# Admin Backend (Node/Express) — copy to .env. NEVER commit the real .env.
PORT=4000

# Local dev: set MONGO_URI directly.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/cartoonflix
# Cloud (Lambda): set MONGO_SECRET_ARN instead; the value is fetched at runtime.
# MONGO_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/mongo-uri

# AWS — in Lambda this comes from the execution role; only needed locally.
AWS_REGION=ap-south-1

# HLS/output bucket. Finished HLS lands under <contentId>/, chosen stills
# under posters/<contentId>/.
HLS_BUCKET=cartoonflix-hls
# CloudFront domain fronting the HLS bucket (used to build playback + poster URLs)
CLOUDFRONT_DOMAIN=<distribution-id>.cloudfront.net

# Raw uploads bucket — only used by the cloud transcode path.
RAW_BUCKET=cartoonflix-raw

# --- Metadata enrichment (TMDB) ---
# Free key from themoviedb.org: Settings -> API -> request an API key (v3 auth).
# Never sent to the browser; lookups are proxied through this server.
TMDB_API_KEY=
# Country used to pick a certification (U/PG/etc). Falls back to US.
TMDB_REGION=IN
# TMDB answers on two hostnames. The default is api.tmdb.org, because several
# ISPs reset TLS connections to api.themoviedb.org by hostname — measured here
# at 7 failures in 10 against it and 0 in 10 against the alias. Switch only if
# your network behaves the other way round.
# TMDB_API_HOST=https://api.themoviedb.org

# --- Local ingest pipeline ---
# Working directory for transcode jobs. Must match ffmpeg-service's MEDIA_ROOT.
MEDIA_ROOT=../media
# Where to find the ffmpeg-service package this server shells out to.
FFMPEG_SERVICE_DIR=../ffmpeg-service

# Auth — local dev: set JWT_SECRET; cloud: set JWT_SECRET_ARN (fetched at runtime).
JWT_SECRET=change-me-in-dev
# JWT_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/jwt-secret
