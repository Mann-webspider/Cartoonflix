# Admin Backend (Node/Express) — copy to .env. NEVER commit the real .env.
PORT=4000

# Local dev: set MONGO_URI directly.
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/cartoonflix
# Cloud (Lambda): set MONGO_SECRET_ARN instead; the value is fetched at runtime.
# MONGO_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/mongo-uri

# AWS — in Lambda this comes from the execution role; only needed locally.
AWS_REGION=ap-south-1

# Raw uploads bucket (movie presign target -> triggers transcode)
RAW_BUCKET=cartoonflix-raw
# HLS/output bucket (poster/thumbnail image uploads land under posters/)
HLS_BUCKET=cartoonflix-hls
# CloudFront domain fronting the HLS bucket (used to build public poster URLs)
CLOUDFRONT_DOMAIN=<distribution-id>.cloudfront.net

# Auth — local dev: set JWT_SECRET; cloud: set JWT_SECRET_ARN (fetched at runtime).
JWT_SECRET=change-me-in-dev
# JWT_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/jwt-secret
