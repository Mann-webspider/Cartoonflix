# Admin Backend (Node/Express) — copy to .env and fill in. NEVER commit the real .env.
PORT=4000

# MongoDB Atlas serverless connection string
MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>/cartoonflix

# AWS — prefer an IAM role in deployment; these are for local dev only.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket that holds raw uploaded videos (presigned PUT target)
AWS_S3_BUCKET_ORIGINAL=cartoonflix-raw
