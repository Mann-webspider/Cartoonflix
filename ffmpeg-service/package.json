{
  "name": "ffmpeg-service",
  "version": "2.0.0",
  "description": "Local HLS ingest pipeline + one-shot cloud transcode worker + orchestration lambdas",
  "type": "module",
  "main": "src/worker.js",
  "scripts": {
    "start": "node src/worker.js",
    "ingest": "node src/cli.js ingest",
    "publish": "node src/cli.js publish",
    "package:lambdas": "node scripts/package-lambdas.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-ecs": "^3.717.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/client-secrets-manager": "^3.717.0",
    "@aws-sdk/lib-storage": "^3.1114.0",
    "@smithy/node-http-handler": "^3.3.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "mongodb": "^6.12.0",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
