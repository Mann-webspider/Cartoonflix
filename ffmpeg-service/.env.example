# Transcode worker (Node/FFmpeg) — copy to .env and fill in. NEVER commit the real .env.
# AWS — prefer an IAM task role in deployment; these are for local dev only.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 bucket for transcoded HLS output
AWS_S3_BUCKET=cartoonflix-hls

# Admin API base URL used to mark content ready after transcode
BACKEND_URL=http://localhost:4000

# CloudFront distribution domain that fronts the HLS bucket
# NOTE: legacy code reads AWS_CLOUDFRONY_URL (typo) — kept for compatibility,
# to be renamed to AWS_CLOUDFRONT_URL in the Phase 3 refactor.
AWS_CLOUDFRONY_URL=https://<distribution-id>.cloudfront.net
