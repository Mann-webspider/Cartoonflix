# Local ingest pipeline + cloud transcode worker. Copy to .env.
# NEVER commit the real .env.

AWS_REGION=ap-south-1

# Where finished HLS and stills are published.
HLS_BUCKET=cartoonflix-hls
CLOUDFRONT_DOMAIN=<distribution-id>.cloudfront.net

# Working directory for local ingest. Each job lands in
# <MEDIA_ROOT>/<contentId>[/s<N>e<N>]/{source.*,hls/,thumbs/,manifest.json}.
# Must match admin-backend's MEDIA_ROOT — both point at the same folder.
MEDIA_ROOT=../media

# Transcode tuning
# FFMPEG_PATH=/usr/bin/ffmpeg    # override ffmpeg (defaults to the bundled static binary)
# FFPROBE_PATH=/usr/bin/ffprobe  # override ffprobe
# USE_GPU=1                      # 1 forces NVENC, 0 forces libx264, unset auto-detects

# --- Cloud transcode path only (unchanged; the local pipeline does not use these) ---
# RAW_BUCKET=cartoonflix-raw
# MONGO_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/mongo-uri
# MONGO_URI=mongodb+srv://...
