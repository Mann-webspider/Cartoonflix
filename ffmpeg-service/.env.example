# Transcode worker + local CLI — copy to .env. NEVER commit the real .env.
AWS_REGION=ap-south-1

# Buckets
RAW_BUCKET=cartoonflix-raw
HLS_BUCKET=cartoonflix-hls

# CloudFront domain fronting the HLS bucket (used to build video_url)
CLOUDFRONT_DOMAIN=<distribution-id>.cloudfront.net

# Local CLI only: admin API base used to mark content ready after transcode
BACKEND_URL=http://localhost:4000

# Optional transcode tuning
# FFMPEG_PATH=/usr/bin/ffmpeg   # override ffmpeg binary (defaults to bundled static)
# USE_GPU=1                     # 1 force NVENC, 0 force libx264, unset = auto-detect

# Completion Lambda only (updates DB after the cloud task finishes)
# MONGO_SECRET_ARN=arn:aws:secretsmanager:...:secret:cartoonflix/mongo-uri
# MONGO_URI=mongodb+srv://...   # local alternative
