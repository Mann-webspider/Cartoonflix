# Admin dashboard config. Copy to .env.local. NEVER commit real .env files.
# Leave unset to render the dashboard on bundled demo data (no backend needed).

# Admin API base (Node/Express). Cloud example:
#   https://<api-id>.execute-api.ap-south-1.amazonaws.com/api/v1/admin
# Local: http://localhost:4000/api/v1/admin
NEXT_PUBLIC_ADMIN_API_URL=
