# Viewer frontend config. Copy to .env.local. NEVER commit real .env files.
# Leave BOTH unset to run on bundled demo data (no backend needed).

# User API base (Go/Fiber). Cloud example:
#   https://<api-id>.execute-api.ap-south-1.amazonaws.com/api/v1
# Local: http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=

# Admin API base for auth (login/signup). Cloud example:
#   https://<api-id>.execute-api.ap-south-1.amazonaws.com/api/v1/admin
# Local: http://localhost:4000/api/v1/admin
NEXT_PUBLIC_ADMIN_API_URL=
