# Viewer frontend config. Copy to .env.local for local work.
# In Vercel these go in Project Settings -> Environment Variables.

# Base URL of the viewer API (the Go Lambda).
#
# Either shape works — the client appends /api/v1 when it is missing:
#   https://<id>.lambda-url.<region>.on.aws
#   https://<id>.lambda-url.<region>.on.aws/api/v1
#
# Leave it UNSET to run on the bundled sample catalogue with no backend.
# Accounts, continue-watching, likes and My List are unavailable in that mode.
NEXT_PUBLIC_API_URL=
