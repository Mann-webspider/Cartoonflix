# Viewer frontend config. Copy to .env.local. NEVER commit real .env files.
# Leave unset to run on the bundled sample catalogue (no backend needed);
# accounts, continue-watching and My List are unavailable in that mode.

# Viewer API base (Go/Fiber Lambda). This one URL serves the catalogue,
# search, accounts and personalisation — the admin API is not reachable from
# here, it runs on the operator's own machine.
#
# Cloud:  https://<api-id>.execute-api.ap-south-1.amazonaws.com/api/v1
# Local:  http://localhost:8080/api/v1
NEXT_PUBLIC_API_URL=
